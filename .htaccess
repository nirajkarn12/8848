Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Apache only (nginx: use /sitemap.php — .htaccess is ignored)
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # Browsers often request /favicon.ico automatically
    RewriteRule ^favicon\.ico$ favicon.php [L]

    # Prefer HTTPS when available (hosting/Cloudflare may already handle this)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Cache CSS/JS lightly (upload caching is controlled in assets/uploads/.htaccess)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
</IfModule>
